{
  "name": "paysmart-india",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Full-stack Indian wallet sandbox with SQLite, atomic double-entry transfers and external UPI handoff",
  "scripts": {
    "start": "node server/local.mjs",
    "dev": "node server/local.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "test:java": "bash banking-java/scripts/test.sh",
    "demo:java": "bash banking-java/scripts/demo.sh",
    "build:vercel": "node scripts/build-vercel.mjs",
    "db:migrate:vercel": "node scripts/migrate-libsql.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  }
}
